# Copy to .env.local and edit locally. Never paste keys into chat.
# Confirm free-tier model access and billing/quota settings before live AI tests.
# Choose gemini or groq explicitly. Groq makes no automatic provider fallback.
AI_PROVIDER=gemini
# Groq trial requires a Free-tier Groq account; do not add billing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional verified free fallback: one attempt after two primary HTTP 503s only.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Optional server-only directory for validated AI allowance snapshots.
# Default: .bidwise-cache/estimates in the app directory; keep it across restarts.
# BIDWISE_ESTIMATE_CACHE_DIR=/absolute/private/persistent/path
